# Copy this file to .env.local and fill in the two values below.
#
# Both values come from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The anon key is meant to be public. It is safe to commit it to a
# GitHub Actions secret and safe for it to appear in the built site.
# Row Level Security is what protects the data, not this key.
#
# Never put the service_role key here. It bypasses every security rule.
# The service_role key belongs only in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
